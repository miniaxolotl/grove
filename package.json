{
  "name": "qdrant-memory",
  "version": "0.1.0",
  "description": "Self-hosted agentic memory MCP server using Qdrant vector database with semantic search, entity/relation knowledge graph, and optional reranking",
  "type": "module",
  "main": "dist/index.js",
  "license": "MIT",
  "packageManager": "pnpm@10.30.3",
  "repository": {
    "type": "git",
    "url": ""
  },
  "keywords": [
    "mcp",
    "memory",
    "qdrant",
    "vector-database",
    "semantic-search",
    "knowledge-graph",
    "agent"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "test": "tsx tests/e2e.ts",
    "setup": "tsx scripts/setup.ts",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:restart": "docker compose down && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps",
    "docker:prune": "docker compose down -v"
  },
  "dependencies": {
    "@huggingface/transformers": "~3.0.0",
    "fastmcp": "~1.27.7",
    "uuid": "~11.0.0",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@qdrant-memory/eslint-config": "workspace:*",
    "@qdrant-memory/typescript-config": "workspace:*",
    "@types/node": "~22.0.0",
    "@types/uuid": "~10.0.0",
    "eslint": "~9.0.0",
    "tsx": "~4.19.0",
    "typescript": "~5.6.0"
  }
}
