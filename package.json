{
  "name": "@monorepo/grove",
  "private": true,
  "type": "module",
  "author": "Bramble Labs Inc.",
  "version": "1.5.0",
  "description": "Self-hosted memory for AI agents by Bramble Labs Inc.",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/miniaxolotl/grove.git"
  },
  "homepage": "https://usegrove.cloud",
  "keywords": [
    "mcp",
    "memory",
    "postgresql",
    "vector-database",
    "semantic-search",
    "private-memory",
    "agent",
    "ai",
    "llm",
    "embeddings",
    "supermemory",
    "agentic-memory",
    "context"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @miniaxolotl/grove-server dev",
    "dev:setup": "pnpm services:up && pnpm setup",
    "build": "node scripts/build.mjs",
    "start": "pnpm --filter @miniaxolotl/grove-server start",
    "dev:website": "pnpm --filter website dev",
    "build:website": "pnpm --filter website build",
    "start:website": "pnpm --filter website start",
    "lint:website": "pnpm --filter website lint",
    "check-types:website": "pnpm --filter website check-types",
    "test:website": "pnpm --filter website test",
    "lint": "eslint lib packages/api/src packages/mcp/src packages/grove-opencode-plugin/src scripts tests/src",
    "lint:fix": "pnpm lint --fix",
    "check-types": "tsc --noEmit",
    "test": "pnpm --filter @monorepo/tests test",
    "test:db:setup": "tsx scripts/database/test-bootstrap.ts",
    "models": "tsx scripts/database/models.ts",
    "setup": "pnpm --filter @script/setup run setup",
    "services:up": "docker compose up -d",
    "services:down": "docker compose down",
    "services:restart": "pnpm run services:down && pnpm run services:up",
    "services:logs": "docker compose logs -f",
    "services:ps": "docker compose ps",
    "test:artifacts": "tsx --test tests/artifacts.test.ts",
    "format": "prettier --write \"**/*.{ts,md,json}\"",
    "clean": "rm -rf packages/mcp/dist scripts/setup/dist tests/dist node_modules"
  },
  "devDependencies": {
    "@lib/database": "workspace:*",
    "@lib/environment": "workspace:*",
    "@lib/eslint-config": "workspace:*",
    "@lib/memory": "workspace:*",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@types/amqplib": "^0.10.8",
    "@types/node": "~25.5.0",
    "@types/pg": "^8.15.0",
    "esbuild": "~0.27.7",
    "eslint": "~10.1.0",
    "prettier": "~3.8.1",
    "release-please": "17.6.0",
    "tsx": "~4.21.0",
    "typescript": "~6.0.2"
  }
}
