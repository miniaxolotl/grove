{
  "name": "@miniaxolotl/grove-opencode-plugin",
  "version": "0.5.0",
  "type": "module",
  "description": "Grove private memory for OpenCode V2: bounded recall and four authenticated tools",
  "main": "index.js",
  "exports": {
    ".": "./index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miniaxolotl/grove.git"
  },
  "keywords": [
    "opencode",
    "grove",
    "memory",
    "context",
    "plugin"
  ],
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "index.js",
    "dist",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node ../../scripts/build.mjs opencode"
  },
  "dependencies": {
    "@opencode/plugin": "2.0.32",
    "zod": "~4.1.8"
  },
  "devDependencies": {
    "@lib/shared": "workspace:*",
    "@lib/integration-core": "workspace:*",
    "@tsconfig/node22": "~22.0.2",
    "@types/node": "~22.13.9",
    "typescript": "~5.8.2"
  }
}
