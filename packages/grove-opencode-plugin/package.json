{
  "name": "@miniaxolotl/grove-opencode-plugin",
  "version": "0.1.0",
  "type": "module",
  "description": "OpenCode plugin for Grove - captures memories, injects hot context, manages importance tiers",
  "main": "dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/miniaxolotl/grove.git"
  },
  "keywords": [
