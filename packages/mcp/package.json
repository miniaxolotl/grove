{
  "name": "@miniaxolotl/grove",
  "version": "0.2.4",
  "type": "module",
  "main": "dist/index.js",
  "description": "Self-hosted agentic memory MCP server backed by Qdrant, inspired by supermemory. Provides semantic memory storage, entity/relation knowledge graph, and optional reranking as MCP tools.",
  "repository": {
    "type": "git",
    "url": "https://github.com/miniaxolotl/grove.git"
  },
  "homepage": "https://github.com/miniaxolotl/grove#readme",
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "mcp",
    "memory",
    "qdrant",
    "vector-database",
    "semantic-search",
    "knowledge-graph",
    "agent",
    "ai",
    "llm",
    "embeddings",
    "supermemory",
    "agentic-memory",
    "context"
  ],
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js",
    "./services/*": "./dist/services/*.js",
    "./repositories/*": "./dist/repositories/*.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@huggingface/transformers": "~3.0.0",
    "fastmcp": "~1.27.7",
    "uuid": "~11.0.0",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@lib/eslint-config": "workspace:*",
    "@lib/typescript-config": "workspace:*",
    "@types/uuid": "~11.0.0",
    "tsx": "~4.21.0",
    "typescript": "~6.0.2"
  }
}
