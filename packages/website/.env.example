# Public origin used for canonical URLs, social previews, sharing, and sitemap.
# Set to the website's HTTPS origin before building for production.
# Production: https://usegrove.cloud
SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
GROVE_API_URL=http://localhost:26080
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Production only; development and preview remain inert. Ingestion keys are public.
NEXT_PUBLIC_POSTHOG_ENABLED=false
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_SENTRY_ENABLED=false
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ENABLED=false
SENTRY_DSN=
# Build-only source-map upload token; never use NEXT_PUBLIC_ for this variable.
SENTRY_AUTH_TOKEN=
