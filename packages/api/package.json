{
  "name": "@miniaxolotl/grove-server",
  "version": "1.11.7",
  "type": "module",
  "description": "Grove private PostgreSQL memory API and worker",
  "repository": {
    "type": "git",
    "url": "https://github.com/miniaxolotl/grove.git"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "exports": "./dist/server.js",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "worker": "node dist/worker.js",
    "migrate": "tsx src/migrate.ts",
    "build": "node ../../scripts/build.mjs api"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1155.0",
    "@aws-sdk/lib-storage": "3.1155.0",
    "@clerk/backend": "3.25.0",
    "@hono/node-server": "^1.19.0",
    "@huggingface/transformers": "~3.0.0",
    "@modelcontextprotocol/sdk": "1.32.1",
    "@vercel/flags-core": "1.10.1",
    "amqplib": "^2.2.0",
    "fflate": "0.8.2",
    "hono": "4.13.13",
    "jose": "^6.1.0",
    "knex": "3.3.0",
    "objection": "3.1.5",
    "pdfjs-dist": "6.4.299",
    "pg": "8.16.3",
    "saxes": "6.0.0",
    "sharp": "0.35.5",
    "stripe": "23.0.1",
    "svix": "^1.80.0",
    "zod": "~4.1.8"
  },
  "devDependencies": {
    "@lib/ai": "workspace:*",
    "@lib/config": "workspace:*",
    "@lib/database": "workspace:*",
    "@lib/environment": "workspace:*",
    "@lib/integration-core": "workspace:*",
    "@lib/memory": "workspace:*",
    "@lib/shared": "workspace:*",
    "@lib/telemetry": "workspace:*"
  }
}
