{
  "name": "@qdrant-memory/server",
  "version": "0.2.1",
  "type": "module",
  "main": "dist/index.js",
  "repository": {
    "type": "git",
    "url": "https://github.com/miniaxolotl/qdrant-memory.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./dist/index.js",
    "./config": "./dist/config.js",
    "./services/*": "./dist/services/*.js",
    "./repositories/*": "./dist/repositories/*.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix"
  },
  "dependencies": {
    "@huggingface/transformers": "~3.0.0",
    "fastmcp": "~1.27.7",
    "uuid": "~11.0.0",
    "zod": "~3.25.0"
  },
  "devDependencies": {
    "@qdrant-memory/eslint-config": "workspace:*",
    "@qdrant-memory/typescript-config": "workspace:*",
    "@types/uuid": "~11.0.0",
    "tsx": "~4.21.0",
    "typescript": "~6.0.2"
  }
}
