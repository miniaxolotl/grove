{
  "jobs": [
    "website",
    "website-quality",
    "extension",
    "contracts",
    "contracts-quality",
    "image"
  ],
  "rules": [
    {
      "prefix": "packages/browser-extension/",
      "jobs": ["extension", "contracts", "contracts-quality"]
    },
    {
      "prefix": "packages/website/",
      "jobs": ["website", "website-quality"]
    },
    {
      "prefix": "packages/api/",
      "jobs": ["contracts", "contracts-quality", "image"]
    },
    {
      "prefix": "lib/",
      "jobs": [
        "website",
        "website-quality",
        "extension",
        "contracts",
        "contracts-quality",
        "image"
      ]
    },
    {
      "prefix": "packages/mcp/",
      "jobs": ["contracts", "contracts-quality", "image"]
    },
    {
      "prefix": "packages/grove-",
      "jobs": ["contracts", "contracts-quality", "image"]
    }
  ]
}
