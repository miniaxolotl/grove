{
  "$schema": "https://raw.githubusercontent.com/googleapis/release-please/main/schemas/config.json",
  "release-type": "node",
  "include-component-in-tag": true,
  "include-v-in-tag": true,
  "packages": {
    "packages/api": {
      "release-type": "node",
      "component": "grove-server",
      "package-name": "@miniaxolotl/grove-server"
    },
    "packages/grove-claude-plugin": {
      "release-type": "node",
      "component": "grove-claude-plugin",
      "package-name": "@miniaxolotl/grove-claude-plugin",
      "extra-files": [
        {
          "type": "json",
          "path": ".claude-plugin/plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.claude-plugin/marketplace.json",
          "jsonpath": "$.plugins[0].source.version"
        }
      ]
    },
    "packages/grove-codex-plugin": {
      "release-type": "node",
      "component": "grove-codex-plugin",
      "package-name": "@miniaxolotl/grove-codex-plugin",
      "extra-files": [
        {
          "type": "json",
          "path": "plugin.json",
          "jsonpath": "$.version"
        },
        {
          "type": "json",
          "path": "/.agents/plugins/marketplace.json",
          "jsonpath": "$.plugins[0].source.version"
        }
      ]
    },
    "packages/mcp": {
      "release-type": "node",
      "component": "grove",
      "package-name": "@miniaxolotl/grove"
    },
    "packages/grove-opencode-plugin": {
      "release-type": "node",
      "component": "grove-opencode-plugin",
      "package-name": "@miniaxolotl/grove-opencode-plugin"
    }
  },
  "changelog-sections": [
    { "type": "feat", "section": "Features" },
    { "type": "fix", "section": "Bug Fixes" },
    { "type": "perf", "section": "Performance Improvements" },
    { "type": "docs", "section": "Documentation" },
    { "type": "refactor", "section": "Code Refactoring" },
    { "type": "chore", "section": "Miscellaneous Chores", "hidden": true },
    { "type": "ci", "section": "CI/CD", "hidden": true }
  ],
  "separate-pull-requests": false
}
