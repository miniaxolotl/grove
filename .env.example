# Node 24. Copy to .env; never commit real credentials.
PORT=26080
API_ORIGIN=http://localhost:26080
SITE_URL=http://localhost:3000

# Generate each with: openssl rand -hex 32 (hex avoids URL escaping in Compose).
POSTGRES_PASSWORD=
API_DATABASE_PASSWORD=
WORKER_DATABASE_PASSWORD=
CURSOR_SECRET=
# Optional public sharing: a separate 32-byte hex key, API only.
SHARE_LINK_KEY=

# API and worker use separate non-owner roles. Owner credentials are setup-only.
DATABASE_URL=postgresql://grove_api:REPLACE@localhost:5432/grove
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@localhost:5432/grove
DATABASE_SSL=disable

# Dedicated Grove Clerk instance; do not reuse another product's instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_WEBHOOK_SIGNING_SECRET=
# OAuth resource defaults to API_ORIGIN/mcp. Configure that audience in Clerk.

# Self-hosted defaults to local MiniLM; remote role settings are documented in documentation/models.md.
GROVE_EDITION=self-hosted
EMBEDDING_MODE=local
EMBEDDING_CACHE=./data/models
# Optional installation administrator settings UI (Clerk user IDs, comma-separated).
MODEL_ADMIN_SUBJECTS=
MODEL_SETTINGS_KEY=
# For cloud: GROVE_EDITION=cloud plus both server-only, pay-as-you-go credentials.
DEEPINFRA_API_KEY=
MINIMAX_API_KEY=
AI_DAILY_REQUEST_LIMIT=2000
AI_CONCURRENCY=4
INDEXING_CONCURRENCY=2
EMAIL_CONCURRENCY=1
MAINTENANCE_CONCURRENCY=1
BULK_CONCURRENCY=1
JOB_ACCOUNT_CONCURRENCY=2
JOB_PROVIDER_CONCURRENCY=8
WORKER_LANES=indexing,enrichment,email,maintenance,bulk
WORKER_LEGACY_QUEUE=true

# API and worker share private export storage. Compose mounts a persistent volume.
# Cloud defaults to disabled until S3-compatible storage is explicitly configured.
EXPORT_STORAGE=local
EXPORT_DIRECTORY=./data/exports
EXPORT_S3_ENDPOINT=
EXPORT_S3_REGION=us-east-1
EXPORT_S3_BUCKET=
EXPORT_S3_ACCESS_KEY_ID=
EXPORT_S3_SECRET_ACCESS_KEY=
EXPORT_S3_PATH_STYLE=false

# Optional worker services. Database polling remains available without a broker.
AMQP_URL=
ORGANIZATION_INTERVAL_SECONDS=900
RESEND_API_KEY=
EMAIL_FROM=notifications@mail.usegrove.cloud

# Website (also put these in packages/website/.env.local for local Next.js).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
GROVE_API_URL=http://localhost:26080
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Headless clients only; never put their scoped key in a project file.
# GROVE_API_KEY=
