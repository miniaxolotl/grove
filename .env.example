# Node 24. Copy to .env; never commit real credentials.
PORT=26080
API_ORIGIN=http://localhost:26080
SITE_URL=http://localhost:3000
# Optional public OpenAI domain-ownership proof; API only, not an access credential.
OPENAI_APPS_CHALLENGE=

# Generate each with: openssl rand -hex 32 (hex avoids URL escaping in Compose).
POSTGRES_PASSWORD=
API_DATABASE_PASSWORD=
WORKER_DATABASE_PASSWORD=
CURSOR_SECRET=
# Optional public sharing: a separate 32-byte hex key, API only.
SHARE_LINK_KEY=

# API and worker use separate non-owner roles. Owner credentials are setup-only.
DATABASE_URL=postgresql://grove_api:REPLACE@localhost:5432/grove
MIGRATION_DATABASE_URL=postgresql://postgres:REPLACE@localhost:5432/grove
DATABASE_SSL=disable
# Per process; budget the sum across API/worker replicas against database capacity.
DATABASE_POOL_MAX=8
DATABASE_ACQUIRE_TIMEOUT_MS=2000
DATABASE_STATEMENT_TIMEOUT_MS=10000
API_MAX_IN_FLIGHT=32
API_MAX_QUEUED=32
API_QUEUE_TIMEOUT_MS=250
API_REQUEST_TIMEOUT_MS=10000
API_INTERACTIVE_CONCURRENCY=4
API_INTERACTIVE_TIMEOUT_MS=90000

# Dedicated Grove Clerk instance; do not reuse another product's instance.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ISSUER=
CLERK_WEBHOOK_SIGNING_SECRET=
# OAuth resource defaults to API_ORIGIN/mcp. Configure that audience in Clerk.

# Self-hosted defaults to local MiniLM; remote role settings are documented in documentation/models.md.
GROVE_EDITION=self-hosted
# Cloud billing is provisioned separately and stays off until the Vercel flag
# `billing-enabled` is enabled. API/worker must share flags, prices and allowances.
BILLING_CONFIGURED=false
# Same Vercel project's SDK key for the API/worker outside Vercel; website uses OIDC.
FLAGS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recommended: price amount comes from Vercel billing-pro-monthly-usd (starts at 5).
STRIPE_PRO_PRODUCT_ID=
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional legacy fixed-price configuration; product pricing takes precedence.
STRIPE_PRO_MONTHLY_PRICE_ID=
STRIPE_PRO_YEARLY_PRICE_ID=
BILLING_FREE_GENERATION_DAILY=10
BILLING_FREE_GENERATION_MONTHLY=100
BILLING_PRO_GENERATION_DAILY=200
BILLING_PRO_GENERATION_MONTHLY=2000
BILLING_FREE_RESEARCH_DAILY=3
BILLING_FREE_RESEARCH_MONTHLY=10
BILLING_PRO_RESEARCH_DAILY=20
BILLING_PRO_RESEARCH_MONTHLY=200
BILLING_FREE_TRANSCRIPTION_MONTHLY_MS=600000
BILLING_PRO_TRANSCRIPTION_MONTHLY_MS=7200000
BILLING_FREE_SYNTHESIS_MONTHLY_CHARACTERS=10000
BILLING_PRO_SYNTHESIS_MONTHLY_CHARACTERS=200000
EMBEDDING_MODE=local
EMBEDDING_CACHE=./data/models
# Optional installation administrator settings UI (Clerk user IDs, comma-separated).
MODEL_ADMIN_SUBJECTS=
MODEL_SETTINGS_KEY=
# For cloud: GROVE_EDITION=cloud plus both server-only, pay-as-you-go credentials.
DEEPINFRA_API_KEY=
MINIMAX_API_KEY=
EXA_API_KEY=
TAVILY_API_KEY=
# Ask Grove research calls per account/day; shared monthly provider estimate (USD).
RESEARCH_DAILY_CALL_LIMIT=20
RESEARCH_MONTHLY_BUDGET_USD=100

# Installation opt-in. New accounts start transcription off and Read aloud on.
SPEECH_ENABLED=false
OPENAI_API_KEY=
TTS_VOICE=alloy
# Additional voices reuse the server-only MINIMAX_API_KEY above; requires artifacts.
MINIMAX_TTS_ENABLED=false
SPEECH_PROVIDER_CONCURRENCY=2
AI_DAILY_REQUEST_LIMIT=2000
AI_CONCURRENCY=4
INDEXING_CONCURRENCY=2
EMAIL_CONCURRENCY=1
MAINTENANCE_CONCURRENCY=1
BULK_CONCURRENCY=1
JOB_ACCOUNT_CONCURRENCY=2
JOB_PROVIDER_CONCURRENCY=8
WORKER_LANES=indexing,enrichment,email,maintenance,bulk
WORKER_LEGACY_QUEUE=true

# API and worker share private export storage. Compose mounts a persistent volume.
# Cloud defaults to disabled until S3-compatible storage is explicitly configured.
EXPORT_STORAGE=local
EXPORT_DIRECTORY=./data/exports
EXPORT_S3_ENDPOINT=
EXPORT_S3_REGION=us-east-1
EXPORT_S3_BUCKET=
EXPORT_S3_ACCESS_KEY_ID=
EXPORT_S3_SECRET_ACCESS_KEY=
EXPORT_S3_PATH_STYLE=false

# Private media: apply migration 017 before enabling API/worker media storage.
# Cloud must use private DigitalOcean Spaces/S3; local mode is self-host/test only.
# Spaces endpoint: https://<region>.digitaloceanspaces.com (not a public CDN URL).
# Never reuse expiring export storage/credentials for retained source media.
MEDIA_STORAGE=disabled
MEDIA_DIRECTORY=./data/media
MEDIA_S3_ENDPOINT=
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=
MEDIA_S3_ACCESS_KEY_ID=
MEDIA_S3_SECRET_ACCESS_KEY=
MEDIA_S3_LIFECYCLE_VERIFIED_FOR=
MEDIA_S3_PATH_STYLE=false

# Optional worker services. Database polling remains available without a broker.
AMQP_URL=
ORGANIZATION_INTERVAL_SECONDS=900
RESEND_API_KEY=
EMAIL_FROM=notifications@mail.usegrove.cloud

# Website (also put these in packages/website/.env.local for local Next.js).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
GROVE_API_URL=http://localhost:26080
# Flags Explorer authentication (generated by Vercel; server-only).
FLAGS_SECRET=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Headless clients only; never put their scoped key in a project file.
# GROVE_API_KEY=
